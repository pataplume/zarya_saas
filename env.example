# ============================================================================
# .env.example — ZARYA
# Copie ce fichier en .env.local et remplis les valeurs
# Ne JAMAIS commit le .env.local (déjà dans .gitignore)
# ============================================================================

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ZARYA
NODE_ENV=development

# ----------------------------------------------------------------------------
# Supabase — eu-central-1 (Frankfurt)
# https://supabase.com/dashboard → Settings → API
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here-NEVER-EXPOSE-CLIENT-SIDE

# Connection string Postgres direct (pour Drizzle migrations)
DATABASE_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres

# ----------------------------------------------------------------------------
# AWS Bedrock — eu-central-1 (Frankfurt)
# ----------------------------------------------------------------------------
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Modèles autorisés (cf. /docs/architecture/llm-strategy.md)
BEDROCK_MODEL_SONNET=anthropic.claude-sonnet-4-6-20250101-v1:0
BEDROCK_MODEL_HAIKU=anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_EMBED=cohere.embed-multilingual-v3

# ----------------------------------------------------------------------------
# Mistral La Plateforme (OCR) — eu-west-3 (Paris)
# ----------------------------------------------------------------------------
MISTRAL_API_KEY=your-mistral-key
MISTRAL_OCR_ENDPOINT=https://api.mistral.ai/v1/ocr

# ----------------------------------------------------------------------------
# Microsoft Graph API
# Azure Portal → App Registrations → ZARYA
# ----------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=your-app-client-id
MICROSOFT_CLIENT_SECRET=your-app-client-secret
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback

# Webhooks Graph
MICROSOFT_WEBHOOK_SECRET=generate-a-random-secret-here
MICROSOFT_WEBHOOK_PUBLIC_URL=https://your-ngrok-url.ngrok.io

# ----------------------------------------------------------------------------
# Zefix (entreprises suisses) — pas d'auth requise
# ----------------------------------------------------------------------------
ZEFIX_BASE_URL=https://www.zefix.ch/ZefixPublicREST/api/v1

# ----------------------------------------------------------------------------
# Stripe
# https://dashboard.stripe.com/test/apikeys
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs (à créer dans Stripe Dashboard)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_SETUP_STARTER=price_...
STRIPE_PRICE_SETUP_PRO=price_...

# ----------------------------------------------------------------------------
# Email transactionnel (Resend ou Mailgun EU)
# ----------------------------------------------------------------------------
RESEND_API_KEY=re_...
EMAIL_FROM_ADDRESS=notifications@zarya.ch
EMAIL_FROM_NAME=ZARYA

# ----------------------------------------------------------------------------
# Sentry (monitoring) — région EU
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@xxxxx.ingest.de.sentry.io/xxxxx
SENTRY_AUTH_TOKEN=sntrys_...
SENTRY_ORG=zarya
SENTRY_PROJECT=zarya-web

# ----------------------------------------------------------------------------
# PostHog (analytics produit) — cloud EU
# ----------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# ----------------------------------------------------------------------------
# Sécurité
# ----------------------------------------------------------------------------
# Pour signer les sessions, JWT custom, webhooks internes
# Générer avec : openssl rand -hex 32
APP_SECRET=replace-with-random-32-bytes-hex

# Pour le chiffrement applicatif additionnel (en plus de Supabase Vault)
ENCRYPTION_KEY=replace-with-random-32-bytes-hex

# ----------------------------------------------------------------------------
# Feature flags (optionnel)
# ----------------------------------------------------------------------------
FEATURE_SEARCH_ENABLED=false
FEATURE_FACTURE_ENABLED=false
FEATURE_SALAIRE_ENABLED=false

# ----------------------------------------------------------------------------
# Développement local uniquement
# ----------------------------------------------------------------------------
# Pour tester les webhooks Microsoft en local (ngrok ou similaire)
LOCAL_WEBHOOK_TUNNEL_URL=

# Pour seed la DB en dev
SEED_DEMO_CABINETS=true
