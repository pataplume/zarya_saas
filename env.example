# ============================================================================
# .env.example — ZARYA
# Copie ce fichier en .env.local et remplis les valeurs
# Ne JAMAIS commit le .env.local (déjà dans .gitignore)
# ============================================================================

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ZARYA
NODE_ENV=development
# Niveau de log pino (debug|info|warn|error). Défaut: info.
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# Supabase — eu-central-2 (Zurich, Suisse)
# https://supabase.com/dashboard → Settings → API
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here-NEVER-EXPOSE-CLIENT-SIDE

# Connection string Postgres direct (pour Drizzle migrations)
DATABASE_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres

# Base de TESTS — OPT-IN (recommandé après le lancement). Posée : la suite d'intégration tourne
# PLEIN RÉGIME contre cette base dédiée. Absente : repli sur DATABASE_URL (même la prod —
# décision founder 17.07.2026, en connaissance de cause) en mode live BRIDÉ : pool plafonné à 2
# + concurrence vitest verrouillée (le 16.07.2026, une suite non bridée a saturé les connexions
# de la prod, erreur 53300). Ne JAMAIS lancer la suite complète pendant une démo / un pilote.
# Cf. docs/architecture/dev-environment.md § « Base de tests ».
# TEST_DATABASE_URL=postgresql://postgres:password@db.yyyyy.supabase.co:5432/postgres

# Pool de connexions postgres-js (borné pour la base partagée — cf. CI / addendum ADR 0005)
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=20

# ----------------------------------------------------------------------------
# Infomaniak AI Services — couche IA (souveraineté CH, ADR 0010 ; remplace Bedrock)
# Infomaniak Manager → AI Tools. Secrets SERVEUR uniquement (pino redact actif).
# Aucun model_id codé en dur : lus ici, validés au runtime contre GET /v1/models.
# ----------------------------------------------------------------------------
IK_PRODUCT_ID=
IK_API_TOKEN=
IK_MODEL_CHAT_SMALL=mistralai/Ministral-3-14B-Instruct-2512
IK_MODEL_CHAT_LARGE=Qwen/Qwen3.5-122B-A10B-FP8
IK_MODEL_EMBEDDINGS=bge_multilingual_gemma2
IK_MODEL_VISION=mistralai/Mistral-Small-4-119B-2603
IK_MODEL_RERANKER=

# Pipeline d'extraction : "stub" (heuristique locale, défaut) ou "live" (Infomaniak).
EXTRACTION_MODE=stub

# ----------------------------------------------------------------------------
# Microsoft Graph API (Bloc D) — Azure Portal → App Registrations → ZARYA
# Secrets serveur uniquement (jamais côté client). Cf. ADR 0018.
# ----------------------------------------------------------------------------
MS_CLIENT_ID=your-app-client-id
MS_CLIENT_SECRET=your-app-client-secret
MS_REDIRECT_URI=http://localhost:3000/api/microsoft/callback
# Secret de signature de l'état OAuth (anti-CSRF). openssl rand -hex 32
MS_OAUTH_STATE_SECRET=replace-with-random-32-bytes-hex

# ----------------------------------------------------------------------------
# Crons Vercel (renouvellement subscriptions Graph, génération relances, échéances)
# Secret partagé vérifié par les routes /api/*/cron. openssl rand -hex 32
# ----------------------------------------------------------------------------
CRON_SECRET=replace-with-random-32-bytes-hex

# ----------------------------------------------------------------------------
# Zefix (entreprises suisses) — pas d'auth requise
# ----------------------------------------------------------------------------
ZEFIX_BASE_URL=https://www.zefix.ch/ZefixPublicREST/api/v1

# ----------------------------------------------------------------------------
# Stripe
# https://dashboard.stripe.com/test/apikeys
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs (à créer dans Stripe Dashboard)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_SETUP_STARTER=price_...
STRIPE_PRICE_SETUP_PRO=price_...

# ----------------------------------------------------------------------------
# Email transactionnel (Resend ou Mailgun EU)
# ----------------------------------------------------------------------------
RESEND_API_KEY=re_...
EMAIL_FROM_ADDRESS=notifications@zarya.ch
EMAIL_FROM_NAME=ZARYA

# ----------------------------------------------------------------------------
# Observabilité (P0-1, AUDIT-MVP §8) — tout est OPTIONNEL : no-op silencieux si absent
# ----------------------------------------------------------------------------
# Sentry serveur (erreurs Server Components / Route Handlers / Server Actions).
# Créer un projet Sentry région EU → DSN. Sans DSN, Sentry n'est jamais initialisé.
SENTRY_DSN=
# Sentry navigateur (optionnel — erreurs côté client). Inline au build Next.
NEXT_PUBLIC_SENTRY_DSN=
# Heartbeat des 7 crons Vercel (pattern healthchecks.io) : GET ${URL}/${slug} si OK,
# GET ${URL}/${slug}/fail si échec. Ex : https://hc-ping.com/<ping-key>
# Slugs : microsoft-renew, calendar-horizon-echeances, calendar-maj-echeances,
# calendar-generer-relances, documents-process-emails, salaire-generer-periodes,
# salaire-relances.
CRON_HEARTBEAT_URL=
# Webhook d'alerte ops critique (Slack/Make/ntfy… au choix) : reçoit un POST JSON
# {subject, context, timestamp} — déclenché notamment sur 401/403 des API tierces
# (Microsoft Graph, Zefix) = credentials cassés (règle CLAUDE.md §Errors).
OPS_ALERT_WEBHOOK_URL=

# ----------------------------------------------------------------------------
# Sécurité
# ----------------------------------------------------------------------------
# Pour signer les sessions, JWT custom, webhooks internes
# Générer avec : openssl rand -hex 32
APP_SECRET=replace-with-random-32-bytes-hex

# Pour le chiffrement applicatif additionnel (en plus de Supabase Vault)
ENCRYPTION_KEY=replace-with-random-32-bytes-hex

# ----------------------------------------------------------------------------
# Feature flags (optionnel)
# ----------------------------------------------------------------------------
FEATURE_SEARCH_ENABLED=false
FEATURE_FACTURE_ENABLED=false
FEATURE_SALAIRE_ENABLED=false

# ----------------------------------------------------------------------------
# Développement local uniquement
# ----------------------------------------------------------------------------
# Pour tester les webhooks Microsoft en local (ngrok ou similaire)
LOCAL_WEBHOOK_TUNNEL_URL=

# Pour seed la DB en dev
SEED_DEMO_CABINETS=true
