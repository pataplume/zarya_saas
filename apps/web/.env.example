# ─── Supabase ────────────────────────────────────────────────────────────────
# Obtenir depuis : Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=     # NE JAMAIS EXPOSER CÔTÉ CLIENT

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Base de données ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ─── Zefix (registre du commerce suisse) ─────────────────────────────────────
# Obtenir en envoyant un email à zefix@bj.admin.ch
# ADR 0009 : NE JAMAIS EXPOSER CÔTÉ CLIENT — variables serveur uniquement
#
# Intégration (tests) : https://www.zefixintg.admin.ch/ZefixPublicREST/api/v1
# Production          : https://www.zefix.admin.ch/ZefixPublicREST/api/v1
ZEFIX_BASE_URL=https://www.zefixintg.admin.ch/ZefixPublicREST/api/v1
ZEFIX_USERNAME=
ZEFIX_PASSWORD=
