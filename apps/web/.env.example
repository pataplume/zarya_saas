# ─── Supabase ────────────────────────────────────────────────────────────────
# Obtenir depuis : Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=     # NE JAMAIS EXPOSER CÔTÉ CLIENT

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Base de données ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ─── Infomaniak AI Services (couche IA, souveraineté CH — ADR 0010) ──────────
# Obtenir depuis : Infomaniak Manager → AI Tools → produit AI.
# Secrets SERVEUR uniquement — NE JAMAIS EXPOSER CÔTÉ CLIENT (pino redact actif).
# Aucun model_id codé en dur : ils sont lus ici (catalogue IK en Beta) et
# validés au runtime contre GET /v1/models. Laisser vide une catégorie inutilisée.
IK_PRODUCT_ID=
IK_API_TOKEN=
IK_MODEL_CHAT_SMALL=mistralai/Ministral-3-14B-Instruct-2512
IK_MODEL_CHAT_LARGE=Qwen/Qwen3.5-122B-A10B-FP8
IK_MODEL_EMBEDDINGS=bge_multilingual_gemma2
IK_MODEL_VISION=
IK_MODEL_RERANKER=

# Mode du pipeline d'extraction : "stub" (heuristique locale, défaut) ou
# "live" (appel Infomaniak). Le stub reste le défaut en prod tant que la
# bascule classification n'est pas validée (Phase 4.0).
EXTRACTION_MODE=stub

# ─── Zefix (registre du commerce suisse) ─────────────────────────────────────
# Obtenir en envoyant un email à zefix@bj.admin.ch
# ADR 0009 : NE JAMAIS EXPOSER CÔTÉ CLIENT — variables serveur uniquement
#
# Intégration (tests) : https://www.zefixintg.admin.ch/ZefixPublicREST/api/v1
# Production          : https://www.zefix.admin.ch/ZefixPublicREST/api/v1
ZEFIX_BASE_URL=https://www.zefixintg.admin.ch/ZefixPublicREST/api/v1
ZEFIX_USERNAME=
ZEFIX_PASSWORD=
